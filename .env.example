# Kosher Pass - mobile app environment.
#
# Copy to `.env` (gitignored) and fill in. Expo CLI loads `.env` automatically
# before evaluating `app.config.ts`, which surfaces these through
# `Constants.expoConfig.extra`.
#
# Everything here ends up inside the shipped bundle and is readable by anyone
# with the app. These are public client identifiers only - never put a
# server-side secret in this file.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Base URL of the NestJS api. MUST be https in any build that leaves your
# machine: iOS ATS and Android cleartext policy block plain http by default.
# For a device on the same LAN as your dev machine, use its IP, not localhost.
API_URL=http://localhost:3000

# development | staging | production. Tags telemetry so you can filter dev noise.
APP_ENV=development

# Shown on the About screen. Leave empty to hide the corresponding row - better
# than shipping a placeholder that silently swallows real user feedback.
SUPPORT_EMAIL=
DEVELOPER_WEBSITE=

# ---------------------------------------------------------------------------
# Error monitoring (Sentry)
# ---------------------------------------------------------------------------
# Project Settings -> Client Keys (DSN). Leave empty to disable Sentry entirely.
SENTRY_DSN=

# Used by the Sentry config plugin to upload source maps during EAS builds, so
# stack traces are readable instead of minified. Not needed for local dev.
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token for the source-map upload. CI/EAS secret only - never commit it.
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Product analytics (PostHog)
# ---------------------------------------------------------------------------
# Project Settings -> Project API Key (the public `phc_...` key).
# Leave empty to disable analytics entirely.
POSTHOG_API_KEY=
# https://eu.i.posthog.com (EU) or https://us.i.posthog.com (US).
POSTHOG_HOST=https://eu.i.posthog.com

# ---------------------------------------------------------------------------
# Ads (AdMob)
# ---------------------------------------------------------------------------
# Master switch. Unless this is exactly "true", the AdMob native plugin is left
# out of the build entirely and no banner ever renders.
ADS_ENABLED=false

# App-level ids (AdMob -> App settings). Required for the plugin to be added;
# without both, the plugin is skipped even when ADS_ENABLED=true, because
# AdMob's native init fails at startup with invalid ids.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=

# Banner unit ids (AdMob -> Ad units). __DEV__ builds always use Google's test
# unit regardless of these values.
ADMOB_BANNER_UNIT_ID_IOS=
ADMOB_BANNER_UNIT_ID_ANDROID=
